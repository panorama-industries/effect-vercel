{
  "$schema": "../../.vscode/schemas/package.schema.json",
  "name": "@panorama-industries/effect-vercel-queue",
  "version": "0.0.0",
  "description": "Effect-native client for Vercel Queues: typed topics, producers, push and poll consumers.",
  "keywords": [
    "effect",
    "queue",
    "sdk",
    "typescript",
    "vercel",
    "vercel-queues"
  ],
  "license": "MIT",
  "author": {
    "name": "Santiago Galán",
    "email": "santiago@panorama.industries",
    "url": "https://sgalanb.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/panorama-industries/effect-vercel",
    "directory": "packages/queue"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "effect-vercel-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@panorama-industries/effect-vercel-core": "workspace:^"
  },
  "devDependencies": {
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.6"
  }
}

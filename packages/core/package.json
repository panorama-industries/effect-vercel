{
  "$schema": "../../.vscode/schemas/package.schema.json",
  "name": "@panorama-industries/effect-vercel-core",
  "version": "0.1.0",
  "description": "Shared Effect building blocks for Vercel service SDKs: environment, OIDC credentials, API client, errors and test utilities.",
  "keywords": [
    "effect",
    "oidc",
    "sdk",
    "typescript",
    "vercel"
  ],
  "license": "MIT",
  "author": {
    "name": "Santiago Galán",
    "email": "santiago@panorama.industries",
    "url": "https://sgalanb.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panorama-industries/effect-vercel.git",
    "directory": "packages/core"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "effect-vercel-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "effect-vercel-source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.6"
  }
}

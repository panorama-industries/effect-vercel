{
  "$schema": "./.vscode/schemas/package.schema.json",
  "name": "effect-vercel",
  "private": true,
  "description": "Effect-native TypeScript SDKs for Vercel services.",
  "keywords": [
    "effect",
    "sdk",
    "typescript",
    "vercel"
  ],
  "license": "MIT",
  "author": {
    "name": "Santiago Galán",
    "email": "santiago@panorama.industries",
    "url": "https://sgalanb.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panorama-industries/effect-vercel.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "check:packages": "pnpm build && pnpm -r exec publint --strict",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-versions.mjs && oxfmt",
    "release": "pnpm build && changeset publish",
    "release:snapshot": "changeset version --snapshot snapshot && node scripts/sync-versions.mjs && pnpm build && changeset publish --tag snapshot --no-git-tag"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0"
}
